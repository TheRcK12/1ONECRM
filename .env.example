# Railway fornece PORT automaticamente. Não crie essa variável manualmente.

# Recomendado: protege a criação do primeiro Dono em uma instalação pública.
ONE_CRM_SETUP_TOKEN=troque-por-um-token-longo-e-secreto

# O Railway já ativa HTTPS no domínio público. Mantenha cookies seguros.
ONE_CRM_SECURE_COOKIES=1
ONE_CRM_TRUST_PROXY_HEADERS=1

# Quando um Volume é anexado, o Railway fornece RAILWAY_VOLUME_MOUNT_PATH.
# Alternativa manual, caso necessário:
# ONE_CRM_DATA_DIR=/app/data

# Opcional: duração das sessões é controlada pelo config.json (12 horas por padrão).

# ONE Intelligence / OpenAI
# Crie a chave na plataforma da OpenAI e salve SOMENTE nas Variables do Railway.
OPENAI_API_KEY=sk-proj-substitua-pela-chave-do-projeto
# Modelo recomendado para cargas sensíveis a custo. Pode ser alterado futuramente.
OPENAI_MODEL=gpt-5.6-luna
ONE_CRM_AI_ENABLED=1
# Limite por usuário dentro da janela abaixo.
ONE_CRM_AI_RATE_LIMIT=10
ONE_CRM_AI_RATE_WINDOW_SECONDS=60
# Timeout da chamada externa, entre 5 e 120 segundos.
ONE_CRM_AI_TIMEOUT=35
# Somente para testes com servidor simulado. Em produção, não altere.
# OPENAI_API_URL=https://api.openai.com/v1/responses
