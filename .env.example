# =========================================================
# ONE CRM 2.5 - EXEMPLO DE CONFIGURAÇÃO
# =========================================================
# Nunca envie um arquivo .env real ao GitHub.
# Railway injeta PORT e RAILWAY_VOLUME_MOUNT_PATH automaticamente.

ONE_CRM_SETUP_TOKEN=SUBSTITUA_POR_UM_TOKEN_COM_PELO_MENOS_32_CARACTERES
ONE_CRM_REQUIRE_SETUP_TOKEN=1
ONE_CRM_REQUIRE_PERSISTENT_STORAGE=1
ONE_CRM_SECURE_COOKIES=1
ONE_CRM_TRUST_PROXY_HEADERS=1
ONE_CRM_SESSION_HOURS=12
ONE_CRM_AUTOMATIC_DAILY_BACKUP=1
ONE_CRM_BACKUP_RETENTION=14

# Opcional. Use somente se existir um frontend em outro domínio.
# Para o domínio normal do próprio CRM, deixe esta variável ausente.
# ONE_CRM_ALLOWED_ORIGINS=https://crm.seudominio.com.br

# ONE Intelligence
ONE_CRM_AI_PROVIDER=groq
ONE_CRM_AI_ENABLED=1
ONE_CRM_AI_LOCAL_FALLBACK=1
ONE_CRM_AI_RATE_LIMIT=10
ONE_CRM_AI_RATE_WINDOW_SECONDS=60
ONE_CRM_AI_TIMEOUT=35

# GroqCloud
GROQ_API_KEY=SUBSTITUA_PELA_CHAVE_REAL
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI é opcional. Configure apenas quando realmente for usar.
# OPENAI_API_KEY=SUBSTITUA_PELA_CHAVE_REAL
# OPENAI_MODEL=SUBSTITUA_PELO_MODELO_ESCOLHIDO

# E-mail para convites e recuperação de senha
ONE_CRM_PUBLIC_URL=https://seu-dominio.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=0
ONE_CRM_ENVIRONMENT=production
