# Railway fornece PORT automaticamente. Não crie essa variável manualmente.

ONE_CRM_SETUP_TOKEN=troque-por-um-token-longo-e-secreto
ONE_CRM_SECURE_COOKIES=1
ONE_CRM_TRUST_PROXY_HEADERS=1

# Quando um Volume é anexado, o Railway fornece RAILWAY_VOLUME_MOUNT_PATH.
# ONE_CRM_DATA_DIR=/app/data

# ONE Intelligence
# Provedor: auto, groq, openai ou local.
ONE_CRM_AI_PROVIDER=auto
ONE_CRM_AI_ENABLED=1
ONE_CRM_AI_LOCAL_FALLBACK=1

# GroqCloud: opção principal para testes sem cartão.
# Crie a chave em https://console.groq.com/keys
GROQ_API_KEY=gsk_substitua-pela-chave
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI: opcional. Remova estas variáveis enquanto não houver faturamento.
# OPENAI_API_KEY=sk-proj-substitua-pela-chave
# OPENAI_MODEL=gpt-5.6-luna

ONE_CRM_AI_RATE_LIMIT=10
ONE_CRM_AI_RATE_WINDOW_SECONDS=60
ONE_CRM_AI_TIMEOUT=35

# Somente para testes com servidores simulados:
# GROQ_API_URL=https://api.groq.com/openai/v1/responses
# OPENAI_API_URL=https://api.openai.com/v1/responses
